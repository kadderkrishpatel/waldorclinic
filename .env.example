# Copy this file to `.env` and replace the placeholders with your real values.
# Variables marked (required) are checked at server startup; missing ones are
# logged as a warning (see src/instrumentation.ts).

# (required) Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# (required) WordPress site that serves the blog posts, e.g. https://yoursite.wordpress.com
# Also used to allow blog images from that host in next.config.ts.
NEXT_PUBLIC_WORDPRESS_BLOGS_URL="https://yoursite.wordpress.com"

# (required) SMTP server used to send contact / careers emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# "true" for port 465 (SSL), otherwise "false".
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"

# (required) Sender and recipient of the enquiry emails.
CONTACT_FROM_EMAIL="Waldor Clinic <no-reply@example.com>"
CONTACT_TO_EMAIL="info@example.com"

# Public URL of the site (canonical URLs, sitemap, robots).
# Defaults to https://waldorclinic.com when not set.
NEXT_PUBLIC_SITE_URL="https://waldorclinic.com"

# Optional: CDN origin for /assets (images, videos, fonts). Leave empty to serve locally.
NEXT_PUBLIC_ASSET_URL=""
